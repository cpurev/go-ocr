
# MongoDB connection string (required).
# Atlas → Connect → Drivers → Go gives you this. Spaces around '=' are fine.
ATLAS = "mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority&appName=my-cluster"

# Where the books live inside the cluster (optional).
MONGO_DB = "go_ocr"
MONGO_COLLECTION = "books"

# How long to wait for connection, server selection, and index creation.
MONGO_TIMEOUT = "10s"

# HTTP server (all optional — these are the defaults).
APP_ENV = "development"
APP_ADDR = ":8080"
LOG_LEVEL = "info"
